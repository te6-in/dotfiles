{
  "skillListingBudgetFraction": 0.02,
  "disableWorkflows": true,
  "disableAgentView": true,
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(trash:*)",
      "Bash(notify:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-tree:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git blame:*)",
      "Bash(git stash list:*)",
      "Bash(npm view:*)",
      "Bash(npm why:*)",
      "Bash(npm list:*)",
      "Bash(npm outdated:*)",
      "Bash(pnpm view:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm outdated:*)",
      "Bash(yarn info:*)",
      "Bash(yarn why:*)",
      "Bash(yarn outdated:*)",
      "Bash(yarn list:*)",
      "Bash(bun info:*)",
      "Bash(bun why:*)",
      "Bash(bun list:*)",
      "Bash(bun outdated:*)",
      "Bash(bun tsc --noEmit:*)",
      "Bash(portless list:*)",
      "Bash(portless get:*)",
      "Bash(portless doctor:*)",
      "mcp__ide__getDiagnostics",
      "mcp__chrome-devtools",
      "mcp__plugin_linear_linear__get_attachment",
      "mcp__plugin_linear_linear__get_document",
      "mcp__plugin_linear_linear__get_issue_status",
      "mcp__plugin_linear_linear__get_issue",
      "mcp__plugin_linear_linear__get_project",
      "mcp__plugin_linear_linear__get_team",
      "mcp__plugin_linear_linear__get_user",
      "mcp__plugin_linear_linear__list_comments",
      "mcp__plugin_linear_linear__list_cycles",
      "mcp__plugin_linear_linear__list_documents",
      "mcp__plugin_linear_linear__list_issue_statuses",
      "mcp__plugin_linear_linear__list_issue_labels",
      "mcp__plugin_linear_linear__list_issues",
      "mcp__plugin_linear_linear__list_projects",
      "mcp__plugin_linear_linear__list_teams",
      "mcp__plugin_linear_linear__save_issue",
      "mcp__plugin_linear_linear__save_comment",
      "mcp__plugin_Notion_notion__notion-fetch",
      "mcp__plugin_slack_slack__slack_read_thread",
      "mcp__plugin_slack_slack__slack_search_public",
      "WebSearch"
    ],
    "deny": [
      "Read(**/*.secret)",
      "Read(**/*.secret.*)",
      "mcp__plugin_linear_linear__*customer*",
      "mcp__plugin_linear_linear__*initiative*",
      "mcp__plugin_linear_linear__*release*",
      "mcp__plugin_linear_linear__*milestone*",
      "mcp__plugin_linear_linear__*diff*",
      "mcp__plugin_linear_linear__*status_update*",
      "mcp__plugin_linear_linear__*agent_skill*",
      "mcp__plugin_linear_linear__create_attachment*",
      "mcp__plugin_linear_linear__prepare_attachment_upload",
      "mcp__plugin_linear_linear__delete_attachment",
      "mcp__plugin_linear_linear__list_users",
      "mcp__plugin_linear_linear__list_project_labels",
      "mcp__plugin_linear_linear__create_issue_label",
      "mcp__plugin_linear_linear__save_document",
      "mcp__plugin_linear_linear__save_project",
      "mcp__plugin_linear_linear__search_documentation",
      "mcp__plugin_Notion_notion__notion-create-database",
      "mcp__plugin_Notion_notion__notion-create-view",
      "mcp__plugin_Notion_notion__notion-download-attachment",
      "mcp__plugin_Notion_notion__notion-duplicate-page",
      "mcp__plugin_Notion_notion__notion-get-teams",
      "mcp__plugin_Notion_notion__notion-get-users",
      "mcp__plugin_Notion_notion__notion-move-pages",
      "mcp__plugin_Notion_notion__notion-query-meeting-notes",
      "mcp__plugin_Notion_notion__notion-update-data-source",
      "mcp__plugin_Notion_notion__notion-update-view",
      "mcp__plugin_slack_slack__*canvas*",
      "mcp__plugin_slack_slack__*reaction*",
      "mcp__plugin_slack_slack__slack_list_channel_members",
      "mcp__plugin_slack_slack__slack_read_user_profile",
      "mcp__plugin_slack_slack__slack_search_emojis",
      "mcp__plugin_slack_slack__slack_search_public_and_private"
    ],
    "ask": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledMcpjsonServers": [
    "seed-design-figma",
    "seed-design-docs"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rewrite-rm-to-trash.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/gh-read-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-lockfile-edits.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/require-linear-issue.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_slack_slack__slack_send_message",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/auto-approve-slack-self-dm.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/linear-noissue-marker.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/sync-theme.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-on-stop.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/direnv-load.sh"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/direnv-load.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "PushNotification",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/push-to-notify.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "/opt/homebrew/bin/starship statusline claude-code"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "linear@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "datadog@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "figma@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {},
  "language": "the language of the user's most recent message",
  "feedbackSurveyRate": 0,
  "effortLevel": "xhigh",
  "emojiCompletionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:material-stone",
  "preferredNotifChannel": "iterm2",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
