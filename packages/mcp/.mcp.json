{
  "mcpServers": {
    "seed-design-figma": {
      "type": "stdio",
      "command": "bunx",
      "args": ["-y", "@seed-design/mcp@latest"],
      "env": {
        "FIGMA_PERSONAL_ACCESS_TOKEN": "${FIGMA_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "seed-design-docs": {
      "type": "stdio",
      "command": "bunx",
      "args": ["-y", "@seed-design/docs-mcp@latest"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "chrome-devtools-mcp",
      "args": ["--isolated", "--headless"]
    },
    "firefox-devtools": {
      "type": "stdio",
      "command": "bunx",
      "args": ["-y", "firefox-devtools-mcp@latest", "--headless", "--enable-script"]
    },
    "ios-simulator": {
      "type": "stdio",
      "command": "bunx",
      "args": ["-y", "ios-simulator-mcp@latest"]
    }
  }
}
